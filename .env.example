# Copy to .env (`make setup`) and change the secrets. Never commit .env.

# --- Data Lake (SeaweedFS, S3-compatible) -----------------------------------
LAKE_BUCKET=credit-risk-lake
LAKE_ACCESS_KEY=lake_dev_access
LAKE_SECRET_KEY=change_me_lake_secret
SEAWEEDFS_VERSION=4.48

# --- Data Warehouse (PostgreSQL) --------------------------------------------
POSTGRES_DB=credit_risk_dw
POSTGRES_USER=dw_admin
POSTGRES_PASSWORD=change_me_dw_password

# --- Synthetic source system -------------------------------------------------
SEED=42
CUSTOMERS_PER_BATCH=150
DIRTY_RATE=0.02

# --- Running Python outside Docker (pytest, quick experiments) ----------------
STORAGE_BACKEND=local
LAKE_LOCAL_PATH=./data/lake
