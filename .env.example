# Copy to .env (`make setup`) and change the secrets. Never commit .env.

# --- Data Lake (SeaweedFS, S3-compatible) -----------------------------------
LAKE_BUCKET=credit-risk-lake
LAKE_ACCESS_KEY=lake_dev_access
LAKE_SECRET_KEY=change_me_lake_secret
SEAWEEDFS_VERSION=4.48

# --- Data Warehouse (PostgreSQL) --------------------------------------------
POSTGRES_DB=credit_risk_dw
POSTGRES_USER=dw_admin
POSTGRES_PASSWORD=change_me_dw_password
# Read-only login roles for the Gold layer consumers (infra/postgres/roles.sql, `make roles`)
ML_READER_PASSWORD=change_me_ml_reader_password
DASHBOARD_READER_PASSWORD=change_me_dashboard_reader_password

# --- dbt ----------------------------------------------------------------------
# Salt for hashing CPFs in staging. Changing it changes every cpf_hash (re-identification cost).
DBT_PII_SALT=change_me_pii_salt

# --- Synthetic source system -------------------------------------------------
SEED=42
CUSTOMERS_PER_BATCH=30
# At 0.01, ~11% of 12-installment label windows lose a row to quarantine
DIRTY_RATE=0.01
# Days of Open Finance history generated before each application
# HISTORY_DAYS=90

# --- Running Python outside Docker (pytest, quick experiments) ----------------
STORAGE_BACKEND=local
LAKE_LOCAL_PATH=./data/lake
# Optional, shown with their defaults. Inside Docker, Compose sets the host and the S3 variables.
# Against SeaweedFS (STORAGE_BACKEND=s3): the AWS_* keys take the LAKE_ACCESS_KEY / LAKE_SECRET_KEY values
# S3_ENDPOINT_URL=http://127.0.0.1:8333
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# Loader: empty = DuckDB's default (~/.duckdb/extensions)
# DUCKDB_EXTENSION_DIRECTORY=
# Written by the ml job, read by the dashboard
# ARTIFACTS_DIR=./data/ml_artifacts
# Out-of-time validation and test periods of the ml job, in months
# VALIDATION_MONTHS=3
# TEST_MONTHS=3
